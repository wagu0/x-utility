{
    "manifest_version": 3,
    "name": "X Utility",
    "version": "1.0",
    "permissions": [
        "downloads",
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://x.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "background": {
        "service_worker": "service_worker.js"
    }
    ,
    "options_page": "options.html",
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "ショートカット設定を開く"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "description": "Xのショートカットを設定するための拡張機能ですX（旧Twitter）の画像保存やいいね、ブックマークなどを、自分で設定したショートカットキーで操作できるようにします。"
}