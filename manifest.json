{
    "manifest_version": 3,
    "name": "X Utility",
    "version": "1.2.0",
    "permissions": [
        "downloads",
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://x.com/*"
            ],
            "js": [
                "content.js",
                "privateAccountFilter.js",
                "mediaDefaultImage.js",
                "accountSwitcher.js",
                "OtherAccountNotification.js",
                "mediaFilter.js"
            ],
            "css": [
                "accountSwitcher.css"
            ]
        }
    ],
    "background": {
        "service_worker": "service_worker.js"
    },
    "options_page": "options.html",
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "__MSG_extensionActionTitle__"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "default_locale": "en",
    "description": "__MSG_extensionDescription__"
}